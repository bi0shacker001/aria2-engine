<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
          The download engine (docs/design.md): libaria2 in an isolated process of its own, a UID with no
          permission and no file of the host's, confined by the sandbox library to the host's broker. Not
          exported: only the host app's main process binds it, and it checks every call.
        -->
        <service
            android:name="io.github.bi0shacker001.aria2engine.EngineService"
            android:process=":aria2"
            android:exported="false"
            android:isolatedProcess="true" />
        <!--
          The same engine on Android 8 to 10, where an isolated process cannot use a socket it was handed: a
          process of its own under the host's UID, still under the lockdown with every path and socket brokered.
          The host's Application runs here too, so a host must start nothing of its own in ":aria2_open".
        -->
        <service
            android:name="io.github.bi0shacker001.aria2engine.EngineOpenService"
            android:process=":aria2_open"
            android:exported="false" />
    </application>
</manifest>
