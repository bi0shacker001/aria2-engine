<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The host of the engine in these tests. The engine's sockets and name lookups are made by the host's broker as
         the host app, so the host holds the network permissions, as any real host does. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- The tests read the runner's checksum file from its plain-HTTP test server (build/range-server.py). -->
    <application android:usesCleartextTraffic="true" />
</manifest>
